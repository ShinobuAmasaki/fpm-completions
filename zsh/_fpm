_fpm_unique () {
	local -a input_array=("$@")
	local -A seen
	local -a result

	for item in "${input_array[@]}"; do
		seen[$item]="1"
	done

	result=("${(@k)seen}")
	echo "${result[@]}"
}

_fpm_are_there_subcommand_arg () {
	local arg_counts seen
	arg_counts=0
	seen=false

	for arg in "${words[@]}"; do
		if [[ "$arg" == "$1" ]]; then
			seen=true
			continue
		fi

		if $seen; then
			if [[ "$arg" == --* ]]; then
				break
			fi
			((arg_counts++))
		fi
	done
	echo "$arg_counts"
}


_fpm_echo_if_exist() {
	type $1 > /dev/null 2>&1 && echo $1
}

_fpm_get_fortran_compilers() {
   local -a fc_list_strict=( "ifort" "ifx" "pgfortran" "nvfortran" \
                     "lfortran" "nagfor" "crayftn" "xlf90" "ftn95" \
                     "mpifort" "mpif90" "mpif77" "caf" "lfc" )
	local -a fc_list_class=("gfortran" "flang")

	typeset -A available

	for cmd in "${(v)commands[@]}"; do
		fullpath=$cmd
		for fc in ${fc_list_strict[@]}; do
			if [[ $fullpath == *"$fc" ]]; then
				available["$cmd"]=$fullpath
			fi
		done
		for fc in ${fc_list_class[@]}; do
			if [[ $fullpath == *"$fc"* ]]; then
				available["$cmd"]=$fullpath
			fi
		done
	done

	for full in "${(v)available[@]}"; do
		cmd=$(basename $full)
		echo $cmd
	done
}

_fpm_get_c_compilers() {
	local -a cc_list
	cc_list=( "gcc" "icc" "icx" "clang" "craycc" "lcc" "mpicc" )

	typeset -A available
	local -a matches

	for cmd in "${(v)commands[@]}"; do
		fullpath=$cmd
		for cc in ${cc_list[@]}; do
			if [[ $fullpath == *"$cc"* ]]; then
				available["$(basename $cmd)"]=$fullpath
			fi
		done
	done

	for item in "${available[@]}"; do
		if [[ $item =~ gcc(-[0-9]+)?$ ]]; then
			matches+=$item
		fi
		if [[ $item =~ clang(-[0-9])?$ ]]; then
			matches+=$item
		fi
		if [[ $item =~ /icc$ ]]; then
			matches+=$item
		fi
		if [[ $item =~ /icx$ ]]; then
			matches+=$item
		fi
		if [[ $item =~ /mpi ]]; then
			matches+=$item
		fi
	done

	for full in "${matches[@]}"; do
		cmd=$(basename $full)
		echo $cmd
	done
}

_fpm_get_cxx_compilers() {
	local -a cxx_list
	cxx_list=( "g++" "icx" "clang++" "mpic++")

	typeset -A available
	local -a matches

	for cmd in "${(v)commands[@]}"; do
		fullpath=$cmd
		for cxx in ${cxx_list[@]}; do
			if [[ $fullpath == *"$cxx"* ]]; then
				available["$(basename $cmd)"]=$fullpath
			fi
		done
	done

	for item in "${available[@]}"; do
		if [[ $item =~ 'g\+\+(-[0-9]+)?$' ]]; then
			matches+=$item
		fi
		if [[ $item =~ 'clang\+\+(-[0-9])?$' ]]; then
			matches+=$item
		fi
		if [[ $item =~ '/icx$' ]]; then
			matches+=$item
		fi
		if [[ $item =~ '/mpi' ]]; then
			matches+=$item
		fi
	done

	for full in "${matches[@]}"; do
		cmd=$(basename $full)
		echo $cmd
	done

}

_fpm_get_archivers() {
	local -a ar_list
	ar_list=( "ar" )
	for element in "${ar_list[@]}"; do
		_fpm_echo_if_exist "$element"
	done
}

_fpm_get_runner_commands() {
	local -a runners
	runners=( "cafrun" "mpiexec" "mpirun" "gdb" "valgrind" )
	for element in "${runners[@]}"; do
		_fpm_echo_if_exist "$element"
	done
}

_fpm_find_manifest_dir() {
	current=$(pwd)

	while [ "$current" != "/" ]; do
		# Is fpm.toml exist?
		if [ -e "$current/fpm.toml" ]; then
			echo "$current"
			return 0
		else
			current=$(dirname "$current")
		fi
	done

	return 1
}

_fpm_get_project_name () {
	local manifest proj_name
	manifest="$(_fpm_find_manifest_dir)/fpm.toml"
	proj_name=$(grep '^name *= *' $manifest | head -n 1 | cut -d'"' -f2)

	echo $proj_name
}

_fpm_get_apps() {
	local -a proj_dir
	local -a unique candidates
	local -a srcs unique combined
	local proj_name

	local dir
	dir=$1

	proj_dir=$( _fpm_find_manifest_dir )
	if [ $? -eq 1 ]; then; return 1; fi
	proj_name=$(_fpm_get_project_name)
	if [ $? -eq 1 ]; then; return 1; fi

	srcs=($(find "$proj_dir/$dir/" -type f \( -name '*.f' -o -name '*.f90' -o -name '*.F' -o -name '*.F90' \) -exec basename {} \; | sed -E 's/\.[fF](90)?$//'))
		
	srcs=("${srcs[@]/main/$proj_name}")

	unique=($(_fpm_unique $srcs))

	for item in "${unique[@]}"; do
		echo $item
	done
}

_fpm_get_apps_app() {
	_fpm_get_apps app
}

_fpm_get_apps_test() {
	_fpm_get_apps test
}

_fpm_get_apps_example() {
	_fpm_get_apps example
}

_fpm_get_rightmost_option() {

	local ret

	for element in "${words[@]}"; do
		if [[ "$element" =~ '^--' ]]; then
			ret=$element
		fi
	done

	# ret="${words[(rha)--*]}"
	echo $ret

}

_fpm_make_option_candidate_for_run () {

	# if [[ $words[CURRENT] != --* ]]; then
		local -a _opts _desc
		_opts=()
		_desc=()
		for opt in ${(k)options}; do
			if [[ $opt == '--example' ]]; then; continue; fi
			
			if [[ ! ${line[*]} =~ $opt ]]; then
				if [[ $1 -ne 0 && $opt == '--all' ]]; then
					continue
				else
					[[ -n ${opt_args[(r)--${opt}]} ]] || _opts+=$opt
				fi
			fi
		done

		if [[ -n "${_opts[*]}"  ]]; then #&& ${words[CURRENT]} != '-' && ${words[CURRENT]} != '--' ]]; then
			compadd -l -V "option" -X "option:" $_opts
		elif  [[ $2 == 'example' ]]; then
			compadd -l -V "option" -X "option:" $_opts
		fi
	# fi
}

_fpm_new() {

	local context state state_descr line
	typeset -A opt_args

  	_arguments \
		'1: :->name'\
		'--backfill[for the pre-exist directory.]' \
		'--full[a much more extensive manifest sample and populated.]' \
		'--bare[a minimal manifest file and README.md file created.]' \
		'--app[create directory app/ and a placeholder main program.]' \
		'(--src --lib)'{--src,--lib}'[create directory src/ and a placeholder module file.]' \
		'--test[create directory test/ and a placeholder program.]' \
		'--example[create directory example/ and a placeholder program.]'

		case "$state" in
			(name)
				_message "Specify your new project name."
				;;
		esac

}

# Problem where the continuation of 'fpm build --list' is not completed.
# Expecting '--tests' to be completed.
_fpm_build() {

	local context state state_descr line
	typeset -A opt_args

	_arguments -S \
			'--verbose[print more information.]'\
			'--tests[build all tests (otherwise only if needed).]' \
		- set_for_list \
			'--list[list candidates instead of building them.]: :->list' \
		- set_for_build \
			'--profile[select the compilation profile for the build.]: :->profile'\
			'--compiler[specify a compiler name.]: :->FC'  \
			'--c-compiler[specify the C compiler name.]: :->CC' \
			'--cxx-compiler[specify the C++ compiler name.]: :->CXX' \
			'--archiver[specify the archiver name.]: :->AR' \
			'--flag[selects compile arguments for the build.]: :->FFLAGS'  \
			'--c-flag[selects compile arguments specific for C source.]: :->CFLAGS'  \
			'--cxx-flag[selects compile arguments specific for C++ source.]: :->CXXFLAGS' \
			'--link-flag[selects arguments passed to the linker for the build.]: :->LDFLAGS' \
			'--show-model[show the model and exit (do not build).]' \
			'--help[print help message and exit.]: :->help'


		case "$state" in
			(profile)
				local -a profs
				profs=( "debug" "release" )
				_values 'Profiles' $profs
				;;
			(list)
				if [[ "${line[*]}" != *--tests* ]]; then
					_message "--list option can only be specified together with --test option"
					_values 'list' '--tests'
				fi
				;;
			(FC)
				local -a compilers
 				compilers=($(_fpm_get_fortran_compilers))
				_values 'Fortran Compiler' $compilers
				;;
			(CC)
				local -a c_compilers
				c_compilers=($(_fpm_get_c_compilers))
				_values 'C Compiler' $c_compilers
				;;
			(CXX)
				local -a cxx_compilers
				cxx_compilers=($(_fpm_get_cxx_compilers))
				_values "C++ Compiler" $cxx_compilers
				;;
			(AR)
				local -a archivers
				archivers=($(_fpm_get_archivers))
				_values "Archiver" $archivers
				;;
			(FFLAGS)
				_message "Select compile arguments for the build."
				;;
			(CFLAGS)
				_message "Select compile arguments specific for C source in the build."
				;;
			(CXXFLAGS)
				_message "Select compile arguments specific for C++ source in the build."
				;;
			(LDFLAGS)
				_message "Select arguments passed to the linker for the build."
				;;
			(help)
				_message "Print the help message."
				;;
		esac

}

_fpm_run() {

	local context state state_descr line
	typeset -A opt_args

	local run_args
	local example_with_arg
	local need_example
	local is_there_all_flag is_there_example_flag is_there_target_flag
	local -a args
	local -a opts desc
	typeset -A options

	## If a user command has already been written, return immediately.
	local user_cmds
	user_cmds=($(grep "^@" ./fpm.rsp 2>/dev/null | cut -c 1-))
	if [[ -n "${user_cmds[*]}" ]]; then
		for item in "${user_cmds[@]}"; do
			if [[ ${words[*]} =~ $item ]]; then
				return 0
			fi
		done
	fi

	## Create an associative array containing all the options
	opts=(--example --all --list --profile --target --compiler --c-compiler --cxx-compiler --archiver --flag --c-flag --cxx-flag --link-flag --runner --runner-args --help --)
	desc=( 
		'run example programs instead of applications.'
		'run all examples or applications.'
		'list basenames of candidates instead of runnning them.'
		'selects the compilation profile for the build.'
		'list of application names to execute.'
		'specify a compiler name.'
		'specify a C compiler name.'
		'specify a C++ compiler name.'
		'sprcify an archiver name.'
		'select compile arguments for the build.'
		'select compile argument specific for C sources.'
		'select compile argument specific for C++ sources.'
		'select arguments passed to the linker for the build.'
		'A command to prefix the program execution paths with.'
		'an additional option to pass command-line arguments to the runner command.'
		'print help message and exit.'
		'optional arguments to pass the program(s).'
	)
	index=1
	while (( index <= $#opts )); do
		options[${opts[index]}]="${desc[index]}"
		((index++))
	done
	
	## Whether the --example option flag is present
	example_with_arg=0
	if [[ " ${words[*]} " =~ ' --example ' ]]; then
		local index=1
		while (( index <= $#words )); do
			if [[ "$words[index]" == "--example" ]]; then
				if [[ -n "${words[index+1]}" && "${words[index+1]}" != --*  ]]; then
					example_with_arg=1
				fi
				break
			fi
			(( index++ ))
		done
	fi

	## Should the --all option be considered?
	need_all=$( [[ $example_with_arg -eq 0 ]] && echo '--all[run all examples or applications.]' )
	if [[ "${words[2]}" =~ '--.*' ]]; then
		:
	else
		need_all=''
	fi

	if [[ "${words[*]}" =~ '--all' ]]; then
		is_there_all_flag='is_true'
	else
		is_there_all_flag='is_false'
	fi

	if [[ "${words[*]}" =~ '--example' ]]; then
		is_there_example_flag='is_true'
	else
		is_there_example_flag='is_false'
	fi

	if [[ "${words[*]}" =~ '--target' ]]; then
		is_there_target_flag='is_true'
	else
		is_there_target_flag='is_false'
	fi

	##　Is a target name specified in the run argument?
	run_args=$(_fpm_are_there_subcommand_arg run)
	need_example=$( [[ $run_args -eq 0 && $is_there_example_flag == 'is_false' ]] && echo '--example[run example programs instead of applications.]: :->example')
	need_target=$( [[ $run_args -eq 0 && $is_there_target_flag == 'is_false' ]] &&  echo '--target[list of application names to execute.]: :->target' )

	_arguments \
			$need_example \
			'--list[list basenames of candidates instead of runnning them.]' \
			'--profile[selects the compilation profile for the build.]: :->profile' \
			$need_target \
			$need_all \
			'--compiler[specify a compiler name.]: :->FC' \
			'--c-compiler[specify the C compiler name.]: :->CC' \
			'--cxx-compiler[specify the C++ compiler name.]: :->CXX' \
			'--archiver[sprcify the archiver name.]: :->AR' \
			'--flag[select compile arguments for the build.]: :->FFLAGS'\
			'--c-flag[select compile argument specific for C sources.]: :->CFLAGS' \
			'--cxx-flag[select compile argument specific for C++ sources.]: :->CXXFLAGS' \
			'--link-flag[select arguments passed to the linker for the build.]: :->LDFLAGS' \
			'--runner[A command to prefix the program execution paths with.]: :->runner' \
			'--runner-args[an additional option to pass command-line arguments to the runner command.]: :->runnerargs' \
			'--help[print help message and exit.]: :->help' \
			'--[optional arguments to pass the program(s).]: :->arg'\
			'*:command or option:->mixed'


	# _message "state: $state"

	case "$state" in
		(mixed)

			## User-defined commands which start with '@'.
			local -a at_cmds
			at_cmds=()
			if [[ "${words[CURRENT]}" =~ '^@' ]]; then
				local -a user_cmds
				user_cmds=($(grep "^@" ./fpm.rsp 2>/dev/null | cut -c 1-))

				for item in "${user_cmds[@]}"; do
					if printf '%s\n' "${words[@]}" | grep -qx -- "$item"; then
						:
					else
						at_cmds+=($item)
					fi
				done
			fi

			if [[ -n "${at_cmds[*]}" ]]; then
				_values 'user commands' $at_cmds
				return 0	
			fi
		#-----------------------------------------------------------#
			## Target application to run
			local -a targets
			local -a unique
			targets=($(_fpm_get_apps_app))
			unique=($(_fpm_unique "${targets[@]}"))
			targets=()
			for item in "${unique[@]}"; do
				if printf '%s\n' "${words[@]}" | grep -qx -- "$item"; then
					:
				else
					targets+=($item)
				fi
			done

			## Target filtering
			if [[ -n "${targets[*]}" ]]; then
				if [[ "$is_there_all_flag" == 'is_false' ]]; then
					if [[ $example_with_arg -eq 0 ]]; then
					if [[ ! "${words[*]}" =~ --* ]]; then
						# _message "List of application names to execute."
						compadd -V "application" -X "application:" $targets
					fi
					fi
				fi
			fi
		#-----------------------------------------------------------#

			local right_opt
			right_opt=$(_fpm_get_rightmost_option)
			if [[ $right_opt == '--target' ]]; then
				if [[ $is_there_all_flag == 'is_false' && $is_there_example_flag == 'is_false' ]]; then
					compadd -V "application" -X "application:" $targets
				fi
			fi
		#-----------------------------------------------------------#

			## example target
			local rigth_most
			rigth_most=($(_fpm_get_rightmost_option))
			targets=()
			unique=()
			if [[ $rigth_most == '--example' ]]; then
				targets=($(_fpm_get_apps_example))
				unique=($(_fpm_unique "${targets[@]}"))

				targets=()
				if [[ -n "${unique}" ]]; then
					if [[ "$is_there_all_flag" == 'is_false' ]]; then

						## Give an example target that is not included in words
						for item in "${unique[@]}"; do
							if ! (( $#words[(r)$item] )); then
								targets+=$item
							fi 
						done
						compadd -V "example application" -X "example application:" $targets
					fi
				fi
			fi

			_fpm_make_option_candidate_for_run $example_with_arg mixed

			;;
		(target)

			local -a targets
			local -a unique

			if [[ $is_there_example_flag == 'is_false' ]]; then
				_message "List of application names to execute."
				targets=($(_fpm_get_apps_app))
			else
				_message "List of example application names to execute."
				targets=($(_fpm_get_apps_example))
			fi

			unique=($(_fpm_unique "${targets[@]}"))
			if [[ -n "${targets[*]}" ]]; then
				_values 'target' $unique
			fi


			;;
		(example)
			local -a targets
			local ret
			local -a all
			
			# example target
			targets=($(_fpm_get_apps_example))
			if [[ -n "${targets[*]}" ]]; then
			 	if [[ $is_there_all_flag == 'is_false' ]]; then
					_message "List of application names to execute."
					# _values 'target:' $targets
					compadd -V "target" -X "target:" $targets
				fi
			fi

			_fpm_make_option_candidate_for_run $example_with_arg example
			
			;;
		(arg)
			_message "Optional arguments ARG to pass the program(s)."
			;;
		(profile)
			local -a profs
			profs=( "debug" "release" )
			_values 'Profile' $profs
			;;
		(runner)
			_fpm_run_runner
			;;
		(runnerargs)
			_message "Pass command-line arguments to the runner command, instead of to the fpm app."
			;;
		(FC)
			local -a compilers
			# compilers=($(_fpm_get_fortran_compilers))
			compilers=($(_fpm_get_fortran_compilers))
			_values 'Fortran Compiler' $compilers
			;;
		(CC)
			local -a c_compilers
			c_compilers=($(_fpm_get_c_compilers))
			_values 'C Compiler' $c_compilers
			;;
		(CXX)
			local -a cxx_compilers
			cxx_compilers=($(_fpm_get_cxx_compilers))
			_values "C++ Compiler" $cxx_compilers
			;;
		(AR)
			local -a archivers
			archivers=($(_fpm_get_archivers))
			_values "Archiver" $archivers
			;;
		(FFLAGS)
			_message "Select compile arguments for the build."
			;;
		(CFLAGS)
			_message "Select compile arguments specific for C source in the build."
			;;
		(CXXFLAGS)
			_message "Select compile arguments specific for C++ source in the build."
			;;
		(LDFLAGS)
			_message "Select arguments passed to the linker for the build."
			;;
		(help)
			_message "Print the help message."
			;;
	esac
}

_fpm_run_runner() {
	local -a runners
	runners=($(_fpm_get_runner_commands))
	_values "runner" $runners
}

_fpm_test() {
	local context state state_descr line
	typeset -A opt_args

	local -a options
	options=(
		--archiver
		--c-compiler
		--c-flag
		--compiler
		--cxx-compiler
		--cxx-flag
		--flag
		--help
		--link-flag
		--list
		--
		--profile
		--runner
		--runner-args
		--target   
	)

	_arguments \
			'--list[list basenames of candidates instead of runnning them.]' \
			'--profile[selects the compilation profile for the build.]: :->profile' \
			'--target[list of application names to execute.]: :->target' \
			'--compiler[specify a compiler name.]: :->FC' \
			'--c-compiler[specify the C compiler name.]: :->CC' \
			'--cxx-compiler[specify the C++ compiler name.]: :->CXX' \
			'--archiver[sprcify the archiver name.]: :->AR' \
			'--flag[select compile arguments for the build.]: :->FFLAGS'\
			'--c-flag[select compile argument specific for C sources.]: :->CFLAGS' \
			'--cxx-flag[select compile argument specific for C++ sources.]: :->CXXFLAGS' \
			'--link-flag[select arguments passed to the linker for the build.]: :->LDFLAGS' \
			'--runner[A command to prefix the program execution paths with.]: :->runner' \
			'--runner-args[an additional option to pass command-line arguments to the runner command.]: :->runnerargs' \
			'--help[print help message and exit.]: :->help' \
			'--[optional arguments to pass the program(s).]: :->arg'\
			'*:command or option:->mixed'

	case "$state" in
		(mixed)
			local -a targets filtered addible_opts

			## test target lists
			if [[ ! "${words[*]}" =~ --* ]]; then
				targets=($(_fpm_get_apps_test))
				filtered=()
				for item in "${targets[@]}"; do
					if printf '%s\n' "${words[@]}" | grep -qx -- "$item"; then
						:
					else
						filtered+=($item)
					fi
				done
				if [[ -n "${filtered[*]}" ]]; then
					compadd -V "test" -X "test to execute:" $filtered
				fi
			fi

			## addible options
			addible_opts=()
			for item in ${options[@]}; do
				if [[ ! "${line[*]}" =~ \s+$item\s+ ]]; then
					addible_opts+=($item)
				fi
			done
			if [[ -n "${addible_opts[*]}" ]]; then
				compadd -V "option" -X "option:" $additional_opts
			fi

			;;
		(target)
			_message "List of application names to execute."
			local -a targets
			targets=($(_fpm_get_apps_test))
			if [[ -n "${targets[*]}" ]]; then
				_values 'target' $targets
			fi
			;;
		(arg)
			_message "Optional arguments ARG to pass the program(s)."
			;;
		(profile)
			local -a profs
			profs=( "debug" "release" )
			_values 'Profile' $profs
			;;
		(runner)
			_fpm_run_runner
			;;
		(runnerargs)
			_message "Pass command-line arguments to the runner command, instead of to the fpm app."
			;;
		(FC)
			local -a compilers
			compilers=($(_fpm_get_fortran_compilers))
			_values 'Fortran Compiler' $compilers
			;;
		(CC)
			local -a c_compilers
			c_compilers=($(_fpm_get_c_compilers))
			_values 'C Compiler' $c_compilers
			;;
		(CXX)
			local -a cxx_compilers
			cxx_compilers=($(_fpm_get_cxx_compilers))
			_values "C++ Compiler" $cxx_compilers
			;;
		(AR)
			local -a archivers
			archivers=($(_fpm_get_archivers))
			_values "Archiver" $archivers
			;;
		(FFLAGS)
			_message "Select compile arguments for the build."
			;;
		(CFLAGS)
			_message "Select compile arguments specific for C source in the build."
			;;
		(CXXFLAGS)
			_message "Select compile arguments specific for C++ source in the build."
			;;
		(LDFLAGS)
			_message "Select arguments passed to the linker for the build."
			;;
		(help)
			_message "Print the help message."
			;;
	esac

}

# Problem where the continuation of 'fpm install --list' is not completed.
# Expecting '--verbose' to be completed.
_fpm_install() {

	local context state state_descr line
	typeset -A opt_args

	_arguments \
			'--verbose[print more information.]'\
		- set_for_list\
			'--list[list all installable targets for this project, but do not install any of them]'\
		- set_for_install\
			'--profile[selects the compilation profile for the build.]: :->profile'\
			'--no-prune[Disables tree-shaking/pruning of unused module dependencies.]'\
			'--flag[selects compile arguments for the build.]: :->FFLAGS'\
			'--c-flag[selects compile arguments specific for C source in the build.]: :->CFLAGS'\
			'--cxx-flag[selects compile arguments specific for C++ source in the build.]: :->CXXFLAGS'\
			'--link-flag[selects arguments passed to the linker for the build.]: :->LDFLAGS'\
			'--no-rebuild[do not rebuild project before installation.]'\
			'--prefix[path to installation directory (requires write access).]: :->prefix'\
			'--bindir[subdirectory to place executables in (default: bin).]: :->bindir'\
			'--libdir[subdirectory to place libraries and archives in (default: lib).]: :->libdir'\
			'--includedir[subdirectory to place headers and module files in (default: include).]: :->includedir'\
			'--test[also install test programs.]'\
			'--testdir[subdirectory to place test programs in (default: test).]: :->testdir'

		case "$state" in
			(profile)
				local -a profs
				profs=( "debug" "release" )
				_values 'Profile' $profs
				;;
			(prefix)
				_path_files -/
				;;
			(bindir)
				_path_files -/
				;;
			(libdir)
				_path_files	-/
				;;
			(includedir)
				_path_files -/
				;;
			(testdir)
				_path_files -/
				;;
			(FFLAGS)
				_message "Select compile arguments for the build."
				;;
			(CFLAGS)
				_message "Select compile arguments specific for C source in the build."
				;;
			(CXXFLAGS)
				_message "Select compile arguments specific for C++ source in the build."
				;;
			(LDFLAGS)
				_message "Select arguments passed to the linker for the build."
				;;
			(help)
				_message "Print the help message."
				;;
		esac
}

_fpm_clean () {

	_arguments \
	- for_skip\
		'--skip[delete the build without prompting but skip dependencies]'\
	- for_all \
		'--all[delete the build without prompting including dependencies]'

}

_fpm() {
	local context state state_descr line
	typeset -A opt_args
	local cmds=("new" "build" "run" "test" "install" "list" "clean" "publish" "help")

	_arguments -C \
		'1: :->command' \
		'*:: :->args' \
		'--list[a brief list of subcommand options.]'

	case "$state" in
		(command)
			if [[ "${words[CURRENT]}" =~ '^@' ]]; then
				local -a user_cmds
				user_cmds=($(grep "^@" ./fpm.rsp 2>/dev/null | cut -c 1-))
				if [[ -n "${user_cmds[*]}" ]]; then
					_values 'user commands' $user_cmds
				fi
			fi
			_values 'commands' $cmds
			;;
		(args)
			case "${line[1]}" in
				(new)
					_fpm_new
					;;
				(build)
					_fpm_build
					;;
				(run)
					_fpm_run
					;;
				(test)
					_fpm_test
					;;
				(install)
					_fpm_install
					;;
				(list)
					_message "list takes no aruguments"
					;;
				(clean)
					_fpm_clean
					;;
				(publish)
					_message "Completion for the sub-command publish is not yet provided."
					;;
				(help)
					_values 'command' $cmds "runner"
					;;
			esac
			;;
	esac
}

compdef _fpm fpm

